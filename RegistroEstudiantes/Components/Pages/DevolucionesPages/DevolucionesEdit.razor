@page "/Devoluciones/Edit/{DevolucionId:int}"
@using RegistroEstudiantes.Models
@using RegistroEstudiantes.Services
@inject NavigationManager navigationManager
@inject DevolucionesService devolucionesService
@rendermode InteractiveServer

<PageTitle>Editar Devolución</PageTitle>

<EditForm Model="@devolucion" OnValidSubmit="Guardar" FormName="EditarDevolucionForm">
    <DataAnnotationsValidator />
    <div class="container mt-4">
        <div class="card shadow-lg">
            <div class="card-header bg-dark text-white">
                <h5 class="card-title mb-0">Editar Devolución de Libro</h5>
            </div>
            <div class="card-body bg-light">
                <div class="mb-3">
                    <label class="form-label font-weight-bold">Préstamo Id:</label>
                    <InputNumber class="form-control" @bind-Value="@devolucion.PrestamoId"></InputNumber>
                    <ValidationMessage For="@(() => devolucion.PrestamoId)" />
                </div>

                <div class="mb-3">
                    <label class="form-label font-weight-bold">Libro Id:</label>
                    <InputNumber class="form-control" @bind-Value="@devolucion.LibroId"></InputNumber>
                    <ValidationMessage For="@(() => devolucion.LibroId)" />
                </div>

                <div class="mb-3">
                    <label class="form-label font-weight-bold">Fecha de Devolución:</label>
                    <InputDate class="form-control" @bind-Value="@devolucion.FachaDevolucion"></InputDate>
                    <ValidationMessage For="@(() => devolucion.FachaDevolucion)" />
                </div>

                <div class="mb-3">
                    <label class="form-label font-weight-bold">Días Prestados:</label>
                    <InputNumber class="form-control" @bind-Value="@devolucion.DiasPrestados"></InputNumber>
                    <ValidationMessage For="@(() => devolucion.DiasPrestados)" />
                </div>
            </div>

            <div class="card-footer bg-light d-flex justify-content-between align-items-center">
                <a href="/Devoluciones/Index" class="btn btn-secondary">
                    <span class="bi bi-arrow-left"> Volver</span>
                </a>
                <div class="d-flex gap-2">
                    <button type="button" class="btn btn-danger bi bi-trash" @onclick="Eliminar"> Eliminar</button>
                    <button type="submit" class="btn btn-dark bi bi-save"> Modificar</button>
                </div>
            </div>
        </div>
    </div>
</EditForm>

@code {
    [Parameter]
    public int DevolucionId { get; set; }

    [SupplyParameterFromForm]
    public Devoluciones devolucion { get; set; } = new();

    private int idActual;

    protected override async Task OnInitializedAsync()
    {
        idActual = DevolucionId;
        var resultado = await devolucionesService.Buscar(DevolucionId);
        resultado.OnSuccess(dev =>
        {
            if (dev != null)
            {
                devolucion = dev;
                idActual = dev.DevolucionesId; 
            }
        });
    }

    public async Task Guardar()
    {
        var resultado = await devolucionesService.Guardar(devolucion);
        if (resultado.IsSuccess)
        {
            navigationManager.NavigateTo("/Devoluciones/Index");
        }
    }

    private async Task Eliminar()
    {
        var resultado = await devolucionesService.Eliminar(idActual);
        if (resultado.IsSuccess)
        {
            navigationManager.NavigateTo("/Devoluciones/Index");
        }
    }
}